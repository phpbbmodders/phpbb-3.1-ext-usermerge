{
    "name": "phpbbmodders/usermerge",
    "type": "phpbb-extension",
    "description": "Allows administrators to merge the accounts of two users",
    "homepage": "https://www.phpbbmodders.com/",
    "version": "1.0.4",
    "time": "2018-01-01",
    "keywords": [
        "phpbb",
        "extension",
        "users",
        "merge",
        "acp"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "phpBB Modders",
            "email": "board@phpbbmodders.com",
            "homepage": "https://www.phpbbmodders.com/",
            "role": "Extension Developer"
        },
        {
            "name": "Rich McGirr",
            "homepage": "http://phpbbmodders.net",
            "email": "rmcgirr83@phpbbmodders.net",
            "role": "Past Developer"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpbb/epv": "dev-master"
    },
    "extra": {
        "display-name": "User Merge",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.19,<4.0.0@dev"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/usermerge",
            "filename": "version_check"
        }
    }
}
